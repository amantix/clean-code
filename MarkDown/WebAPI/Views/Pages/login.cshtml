<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Авторизация на сайт</title>
    <link rel="stylesheet" href="/css/stylesAuth.css">
</head>
<body>
<main>
    <div class="wrapper-auth">
        <div class="container-auth">
            <h1 style="text-align: center; opacity: .3;">Авторизация</h1>
            <form id="loginForm" class="form-style">
                <input type="email" name="email" id="email" placeholder="Email" class="input-style" required>
                <input type="password" name="password" id="password" placeholder="Пароль" class="input-style" required>
                <button type="submit" class="btn">Войти</button>
            </form>
            <a href="/reg" class="choice-auth">Зарегистрироваться</a>
        </div>
    </div>
</main>
</body>
<script src="/js/scriptLogin.js"></script>
</html>