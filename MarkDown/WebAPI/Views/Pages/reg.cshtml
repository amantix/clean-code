<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Авторизация на сайт</title>
  <link rel="stylesheet" href="/css/stylesAuth.css">
</head>
<body>
<main>
  <div class="wrapper-auth">
    <div class="container-auth">
      <h1 style="text-align: center; opacity: .3;">Регистрация</h1>
      <form id="regForm"class="form-style">
        <input type="email" name="email" id="email" placeholder="Email" class="input-style" value="">
        <input type="password" name="password" id="password" placeholder="Пароль" class="input-style" value="">
        <button type="submit" class="btn">Зарегистрироваться</button>
      </form>
      <a href="/login" class="choice-auth">Войти</a>
    </div>
  </div>
</main>
</body>
<script src="/js/scrtiptReg.js"></script>
</html>